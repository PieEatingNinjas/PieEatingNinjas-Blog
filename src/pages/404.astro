---
import Layout from '../layouts/BlogPost.astro';
import { legacyPages } from '../lib/legacy-pages';
import compatibility from '../data/migration-compatibility.json';
const page = legacyPages.notFound;
---

<Layout title={page.title} description={page.description} canonicalPath={page.path}>
	<p>{compatibility.notFound.paragraphs[0]}</p>
	<img src={compatibility.notFound.image} width={compatibility.notFound.measurements.width} height={compatibility.notFound.measurements.height} alt="" />
	<p>{compatibility.notFound.paragraphs[1]}</p>
	<p><a href="/">Browse the blog</a>.</p>
</Layout>

---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../../../layouts/BlogPost.astro';
import { getPosts } from '../../../../lib/posts';
import { parsePostPath, postUrl } from '../../../../lib/urls';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.filter((post) => post.data.legacy).map((post) => {
		const { year, month, day, slug } = parsePostPath(postUrl(post));
		return { params: { year, month, day, slug: decodeURIComponent(slug) }, props: post };
	});
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} canonicalPath={postUrl(post)}>
	<Content />
</BlogPost>

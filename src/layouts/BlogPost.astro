---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';
import LegacyComments from '../components/LegacyComments.astro';
import type { LegacyComment } from '../lib/comments';
import type { TaxonomyTerm } from '../lib/archives';

type Props = Omit<CollectionEntry<'blog'>['data'], 'pubDate' | 'categories' | 'tags'> & {
	pubDate?: Date;
	canonicalPath?: string;
	archiveTerms?: TaxonomyTerm[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	canonicalPath,
	archiveTerms = [],
	codeRepositories = [],
} = Astro.props;
const ageReferenceDate = updatedDate ?? pubDate;
const commentArchives = import.meta.glob<{
	legacyPostId: number;
	comments: LegacyComment[];
}>('../data/comments/*.json', { eager: true, import: 'default' });
const commentArchive = Astro.props.legacy
	? commentArchives[`../data/comments/${Astro.props.legacy.id}.json`]
	: undefined;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} canonicalPath={canonicalPath} />
		<style>
			main {
				max-width: 1120px;
				padding: 2.5rem 1.5rem 3.5rem;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 480px;
				margin: 0 auto;
				object-fit: cover;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 100%;
				max-width: 740px;
				margin: auto;
				padding: 1.25rem 0;
				color: rgb(var(--gray-dark));
			}
			.prose :global(video) {
				width: var(--post-video-width, auto);
				max-width: 100%;
				height: auto;
			}
			.title {
				margin-bottom: 2rem;
				padding: 0 0 1.5rem;
				line-height: 1.2;
			}
			.title hr {
				margin-top: 1.25rem;
			}
			.title h1 {
				margin: 0;
				font-size: clamp(2.25rem, 5vw, 3.25rem);
				line-height: 1.08;
			}
			.repository-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem;
				margin: 1.25rem 0 0;
				padding: 0;
				list-style: none;
			}
			.repository-links a {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.4rem 0.65rem;
				border: 1px solid var(--border);
				border-radius: 6px;
				background: var(--surface);
				color: rgb(var(--gray-dark));
				font-size: 0.8rem;
				font-weight: 700;
				text-decoration: none;
				transition:
					border-color 160ms ease,
					color 160ms ease;
			}
			.repository-links a:hover {
				border-color: var(--accent);
				color: var(--accent-dark);
			}
			.repository-links svg {
				width: 1rem;
				height: 1rem;
				flex: none;
				fill: currentColor;
			}
			.date {
				margin-bottom: 0.75rem;
				color: rgb(var(--gray));
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.025em;
			}
			.last-updated-on {
				margin-top: 0.3rem;
				font-family: var(--font-atkinson);
				font-size: 0.85rem;
				font-style: italic;
				letter-spacing: 0;
			}
			.age-warning {
				margin: 1.25rem 0;
				padding: 0.7rem 0.9rem;
				border-left: 3px solid #b18a42;
				border-radius: 0 6px 6px 0;
				background: #f7f4ec;
				color: #5b513d;
				font-size: 0.88rem;
				line-height: 1.55;
			}
			.prose nav {
				margin-top: 2.5rem;
				padding-top: 1rem;
				border-top: 1px solid var(--border);
				font-size: 0.9rem;
			}
			.prose nav p {
				margin: 0.5rem 0;
			}
			@media (max-width: 720px) {
				main {
					padding: 1.75rem 1rem 2.5rem;
				}
				.prose {
					padding-top: 1rem;
				}
				.title {
					margin-bottom: 1.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && (typeof heroImage === 'string'
						? <img src={heroImage} alt="" />
						: <Image width={1020} height={510} src={heroImage} alt="" />)}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							{pubDate && <FormattedDate date={pubDate} />}
							{updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
						{codeRepositories.length > 0 && (
							<ul class="repository-links" aria-label="Example code repositories">
								{codeRepositories.map((repository) => {
									const repositoryName = new URL(repository).pathname.slice(1);
									return (
										<li>
											<a
												href={repository}
												target="_blank"
												rel="noreferrer"
												aria-label={`View ${repositoryName} on GitHub`}
											>
												<svg viewBox="0 0 24 24" aria-hidden="true">
													<path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.05c-3.34.73-4.04-1.42-4.04-1.42-.55-1.4-1.33-1.77-1.33-1.77-1.09-.75.08-.74.08-.74 1.2.09 1.83 1.23 1.83 1.23 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.4 1.23-3.25-.12-.3-.53-1.54.12-3.2 0 0 1-.32 3.3 1.24a11.5 11.5 0 0 1 6 0c2.3-1.56 3.3-1.24 3.3-1.24.65 1.66.24 2.9.12 3.2.77.85 1.23 1.93 1.23 3.25 0 4.63-2.8 5.65-5.48 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" />
												</svg>
												<span>GitHub repository: {repositoryName}</span>
											</a>
										</li>
									);
								})}
							</ul>
						)}
						{ageReferenceDate && (
							<p
								class="age-warning"
								data-reference-date={ageReferenceDate.toISOString().slice(0, 10)}
								role="note"
								hidden
							>
								This article is more than two years old. Some details may have changed, so check the current documentation before applying them.
							</p>
						)}
						<hr />
					</div>
					<slot />
					{archiveTerms.length > 0 && (
						<nav aria-label="Post categories and tags">
							{(['category', 'tag'] as const).map((kind) => {
								const terms = archiveTerms.filter((term) => term.kind === kind);
								return terms.length > 0 && <p>
									{kind === 'category' ? 'Categories: ' : 'Tags: '}
									{terms.map((term, index) => <>{index > 0 && ', '}<a href={`/${kind}/${term.slug}/`}>{term.name}</a></>)}
								</p>;
							})}
						</nav>
					)}
				</div>
			</article>
			{Astro.props.legacy && <Giscus />}
			{commentArchive && <LegacyComments archive={commentArchive} />}
		</main>
		<Footer />
	</body>
</html>

<script is:inline>
	const ageWarning = document.querySelector('.age-warning');
	const referenceDate = ageWarning?.dataset.referenceDate;

	if (ageWarning && referenceDate) {
		const [year, month, day] = referenceDate.split('-').map(Number);
		const published = new Date(year, month - 1, day);
		const today = new Date();
		const twoYearsAgo = new Date(today.getFullYear() - 2, today.getMonth(), today.getDate());
		ageWarning.hidden = published >= twoYearsAgo;
	}

	document.querySelectorAll('.prose pre').forEach((pre) => {
		const code = pre.querySelector('code');
		if (!code) return;

		const wrapper = document.createElement('div');
		wrapper.className = 'code-block';
		pre.before(wrapper);
		wrapper.append(pre);

		const button = document.createElement('button');
		button.className = 'copy-code-button';
		button.type = 'button';
		button.textContent = 'Copy';
		button.setAttribute('aria-label', 'Copy code to clipboard');
		wrapper.append(button);

		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(code.textContent ?? '');
				button.textContent = 'Copied!';
				button.setAttribute('aria-label', 'Code copied to clipboard');
			} catch {
				button.textContent = 'Copy failed';
				button.setAttribute('aria-label', 'Could not copy code to clipboard');
			}

			window.setTimeout(() => {
				button.textContent = 'Copy';
				button.setAttribute('aria-label', 'Copy code to clipboard');
			}, 2000);
		});
	});
</script>

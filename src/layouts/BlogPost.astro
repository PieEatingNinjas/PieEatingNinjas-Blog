---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import type { TaxonomyTerm } from '../lib/archives';

type Props = Omit<CollectionEntry<'blog'>['data'], 'pubDate' | 'categories' | 'tags' | 'codeRepositories'> & {
	pubDate?: Date;
	canonicalPath?: string;
	archiveTerms?: TaxonomyTerm[];
};

const { title, description, pubDate, updatedDate, heroImage, canonicalPath, archiveTerms = [] } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} canonicalPath={canonicalPath} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.prose :global(video) {
				width: var(--post-video-width, auto);
				max-width: 100%;
				height: auto;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && (typeof heroImage === 'string'
						? <img src={heroImage} alt="" />
						: <Image width={1020} height={510} src={heroImage} alt="" />)}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							{pubDate && <FormattedDate date={pubDate} />}
							{updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					{archiveTerms.length > 0 && (
						<nav aria-label="Post categories and tags">
							{(['category', 'tag'] as const).map((kind) => {
								const terms = archiveTerms.filter((term) => term.kind === kind);
								return terms.length > 0 && <p>
									{kind === 'category' ? 'Categories: ' : 'Tags: '}
									{terms.map((term, index) => <>{index > 0 && ', '}<a href={`/${kind}/${term.slug}/`}>{term.name}</a></>)}
								</p>;
							})}
						</nav>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

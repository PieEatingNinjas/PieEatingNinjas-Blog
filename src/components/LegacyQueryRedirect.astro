---
import compatibility from '../data/legacy-site.json';
---

<script id="legacy-query-ids" type="application/json" set:html={JSON.stringify(compatibility.queryIds).replaceAll('<', '\\u003c')} />
<script>
	import { resolveLegacyQuery, type QueryIdMap } from '../lib/legacy-query';
	const element = document.getElementById('legacy-query-ids');
	if (!element?.textContent) throw new Error('Legacy query-ID map is missing.');
	const ids: QueryIdMap = JSON.parse(element.textContent);
	const target = resolveLegacyQuery(location.search, location.hash, ids);
	if (target) location.replace(target);
</script>

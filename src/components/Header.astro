---
import HeaderLink from './HeaderLink.astro';
import { externalLinkAttributes } from '../lib/external-links';
---

<header>
	<nav>
		<h2 class="brand">
			<a href="/">Pie Eating Ninjas' Blog</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Blog</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
			<HeaderLink href="/book/">Book</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://bsky.app/profile/pieternijs.bsky.social" {...externalLinkAttributes}>Bluesky</a>
			<a href="https://github.com/PieEatingNinjas" {...externalLinkAttributes}>GitHub</a>
			<a href="https://www.linkedin.com/in/pieter-nijs/" {...externalLinkAttributes}>LinkedIn</a>
		</div>
	</nav>
</header>
<style>
	header {
		padding: 0 1.25rem;
		border-bottom: 1px solid var(--border);
		background: var(--surface);
	}
	h2 {
		margin: 0;
		font-size: 1rem;
	}
	.brand a,
	.brand a.active {
		color: rgb(var(--black));
		font-weight: 700;
		letter-spacing: -0.025em;
		text-decoration: none;
		white-space: nowrap;
	}

	nav {
		display: flex;
		max-width: 1080px;
		min-height: 76px;
		margin: 0 auto;
		align-items: center;
		justify-content: flex-end;
		gap: 2rem;
	}
	nav a {
		padding: 0.55rem 0;
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		gap: 1.25rem;
		margin-right: auto;
		margin-right: auto;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 1.1rem;
	}
	.social-links a {
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}
	nav a:hover {
		color: var(--accent-dark);
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}
		nav {
			min-height: 66px;
			gap: 1.25rem;
		}
		.brand a {
			max-width: 11rem;
			font-size: 0.88rem;
			white-space: normal;
			line-height: 1.2;
		}
		.internal-links {
			gap: 0.85rem;
		}
		.social-links {
			display: none;
		}
	}
</style>

---
import { GISCUS_PUBLIC_CONFIG, getGiscusConfig } from '../lib/giscus';

const config = getGiscusConfig(import.meta.env.PUBLIC_GISCUS_ENABLED ?? 'true', GISCUS_PUBLIC_CONFIG);
---

{config && (
	<section class="giscus-comments" aria-label="Community discussion">
		<h2>Join the discussion</h2>
		<script
			is:inline
			data-repo={config.repo}
			data-repo-id={config.repoId}
			data-category={config.category}
			data-category-id={config.categoryId}
			data-mapping="pathname"
			data-strict="1"
			data-reactions-enabled="1"
			data-emit-metadata="0"
			data-input-position="bottom"
			data-theme="/giscus-theme.css"
			data-lang="en"
			data-loading="lazy"
		>
			const configuration = document.currentScript;
			const embed = document.createElement('script');
			for (const { name, value } of configuration.attributes) {
				if (name.startsWith('data-')) embed.setAttribute(name, value);
			}
			// Resolve against the viewing origin, including the Pages preview prefix.
			embed.dataset.theme = new URL(configuration.dataset.theme, window.location.origin).href;
			embed.src = 'https://giscus.app/client.js';
			embed.async = true;
			embed.crossOrigin = 'anonymous';
			configuration.after(embed);
		</script>
	</section>
)}

<style>
	.giscus-comments {
		width: 100%;
		max-width: 740px;
		margin: 0 auto;
		padding: 1.5rem 0;
		color: rgb(var(--gray-dark));
	}
	h2 {
		margin-bottom: 1rem;
		font-size: 1.5rem;
	}
</style>

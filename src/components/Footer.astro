---
import AnalyticsConsent from './AnalyticsConsent.astro';
import { externalLinkAttributes } from '../lib/external-links';
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Pie Eating Ninjas. All rights reserved.
	<div class="social-links">
		<a href="https://bsky.app/profile/pieternijs.bsky.social" {...externalLinkAttributes}>Bluesky</a>
		<a href="https://github.com/PieEatingNinjas" {...externalLinkAttributes}>GitHub</a>
		<a href="https://www.linkedin.com/in/pieter-nijs/" {...externalLinkAttributes}>LinkedIn</a>
	</div>
	<AnalyticsConsent />
</footer>
<style>
	footer {
		padding: 2rem 1rem 3rem;
		border-top: 1px solid var(--border);
		background: var(--surface);
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.82rem;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.25rem;
		margin-top: 0.85rem;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: var(--accent-dark);
	}
</style>

{
  "name": "tmp",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "migration:inventory": "node scripts/migration-inventory.mjs",
    "migration:pilot": "node scripts/migration-import.mjs",
    "migration:posts": "node scripts/migration-import.mjs --all-posts",
    "test:import": "node --test scripts/migration-import.test.mjs",
    "migration:verify-pilot": "node scripts/migration-verify-pilot.mjs",
    "migration:verify-posts": "node scripts/migration-verify-posts.mjs",
    "test:migration": "node --test scripts/migration-inventory.test.mjs",
    "test:routing": "node --experimental-strip-types --test scripts/routing.test.mjs",
    "migration:compatibility": "node scripts/migration-compatibility.mjs",
    "test:compatibility": "node --test scripts/migration-compatibility.test.mjs",
    "migration:verify-compatibility": "node scripts/migration-verify-compatibility.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "sharp": "^0.35.0"
  }
